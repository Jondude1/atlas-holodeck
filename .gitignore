# Godot
.godot/
*.import
export_credentials.cfg

# Export output
builds/*.apk
builds/*.aab
app/android/

# Secrets — never commit credentials of any kind
*.keystore
*.jks
# …except the app's one permanent release-signing key. It is committed on purpose: this is a sideloaded
# app (no Play Store), and CI must sign every GitHub Release with the SAME key or Android refuses the update.
!keystore/atlas-holodeck.jks
*secret*
*token*
.env
# …but app/tokens.gd is the DESIGN-token theme file (colours/grid), not a secret —
# it must be committed or a clean clone cannot build.
!app/tokens.gd
!app/tokens.gd.uid

# Local tooling (not part of the project)
push_api.py

# Reference stills (copyrighted film/show frames — internal design reference only)
research/

# OS / editor noise
.DS_Store
Thumbs.db
*.tmp

# Vendored addons — reproducible via app/fetch_addons.sh (too large to commit)
app/addons/
